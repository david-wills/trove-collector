{
  "manifest_version": 3,
  "name": "Trove Browser Watcher",
  "version": "0.2.0",
  "description": "Reports tab URL, title, favicon, audio playback, and navigation referrer to the local Trove vault via troved. Local-only — no network access, no remote code. Optional, off-by-default page observation (ad tracking) behind Chrome's own permission prompt.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "nativeMessaging", "alarms", "webNavigation", "scripting", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "options_page": "options.html"
}
